# ─────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ─────────────────────────────────────────────────────
# Database (omita pra usar in-memory)
# ─────────────────────────────────────────────────────
DATABASE_URL=postgres://supersdr:supersdr@localhost:55432/supersdr

# ─────────────────────────────────────────────────────
# Meta (WhatsApp Cloud API) — instanceId default: 'default'
# ─────────────────────────────────────────────────────
META_INSTANCE_ID=default
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=supersdr-verify-token

# ─────────────────────────────────────────────────────
# Evolution Baileys
# ─────────────────────────────────────────────────────
EVOLUTION_BAILEYS_BASE_URL=
EVOLUTION_BAILEYS_INSTANCE=default
EVOLUTION_BAILEYS_API_KEY=
EVOLUTION_BAILEYS_WEBHOOK_API_KEY=

# ─────────────────────────────────────────────────────
# Evolution Go
# ─────────────────────────────────────────────────────
EVOLUTION_GO_BASE_URL=
EVOLUTION_GO_INSTANCE=default
EVOLUTION_GO_API_KEY=
EVOLUTION_GO_WEBHOOK_API_KEY=

# ─────────────────────────────────────────────────────
# WPPConnect
# ─────────────────────────────────────────────────────
WPPCONNECT_BASE_URL=
WPPCONNECT_SESSION=default
WPPCONNECT_TOKEN=
WPPCONNECT_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────
# Z-API (instanceId vira a chave do registry)
# ─────────────────────────────────────────────────────
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_WEBHOOK_CLIENT_TOKEN=

# ─────────────────────────────────────────────────────
# Intent Classifier (LLM ou mock)
# Sem env nenhum → usa mock heurístico (dev/CI). Sem custo.
# Providers suportados (OpenAI-compatible):
#   mock | groq | openai | gemini | ollama | openrouter | custom
# ─────────────────────────────────────────────────────
INTENT_CLASSIFIER=mock
INTENT_API_KEY=
# INTENT_BASE_URL=  # default por provider; obrigatório se INTENT_CLASSIFIER=custom
# INTENT_MODEL=     # default por provider (ex: groq=llama-3.1-8b-instant)
INTENT_TIMEOUT_MS=8000
